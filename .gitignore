# Python virtual environments
.venv/
venv/
env/

# Python bytecode and cache files
__pycache__/
*.py[cod]
*$py.class

# Build and packaging artifacts
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Test, type-checker, and linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# Local environment files (keep example templates trackable)
.env
.env.*
!.env.example
!.env.*.example

# Editor and operating-system files
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Runtime logs
*.log
